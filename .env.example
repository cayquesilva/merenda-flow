# Raiz do projeto: front-end (Vite) e variáveis lidas pelos docker-compose.
# Copie para .env e ajuste os valores. O back-end tem o seu próprio back-end/.env.example.

# --- Front-end (Vite) ---
# URL da API. É embutida no build: em produção é passada como build-arg no Dockerfile,
# então mudar a variável no container depois do build não tem efeito.
VITE_API_URL=http://localhost:3001

# --- docker-compose.yml / docker-compose.local.yml ---
POSTGRES_USER=merenda
POSTGRES_PASSWORD=troque-esta-senha
# Assina os tokens de login do back-end (gere um valor aleatório longo em produção).
JWT_SECRET=troque-por-um-valor-aleatorio-longo
# URL pública do front-end (links e QR codes de confirmação). Usada pelo docker-compose.yml.
FRONTEND_URL=https://merenda.portaleducampina.com.br
# Opcional: endpoint compatível com a API da OpenAI. Vazio = https://api.openai.com/v1
OPENAI_BASE_URL=

# --- Apenas docker-compose.local.yml ---
# Porta do front-end no host (também usada pelo cliente de hot reload).
FRONTEND_PORT=8081
# true = servidor de desenvolvimento do Vite com hot reload; false = build + preview.
VITE_HMR=false
