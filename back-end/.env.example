# Back-end (Express + Prisma). Copie para back-end/.env e ajuste os valores.
# Carregado por dotenv em index.ts; a API sempre escuta na porta 3001.

# --- Banco de dados (obrigatório) ---
# Rodando o back-end fora do Docker contra o Postgres do docker-compose.local.yml:
DATABASE_URL=postgresql://merenda:merenda@localhost:5432/merenda

# --- Segurança (obrigatório em produção) ---
# Assina os tokens de login. Sem ele o código usa "fallback-secret-key".
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo
# Opcional: chave de cifra dos segredos guardados no banco (ex.: chave da OpenAI do
# assistente de voz). Vazio = usa JWT_SECRET. Se mudar depois, a chave salva deixa de
# ser lida e precisa ser cadastrada de novo.
APP_SECRET=

# --- URLs públicas ---
# Usada nos links e QR codes de confirmação de guias/recibos.
FRONTEND_URL=http://localhost:8080
# Usada pelo Chromium ao gerar PDFs e na mensagem de inicialização.
BACKEND_URL=http://localhost:3001

# --- Geração de PDF (Puppeteer) ---
# Caminho do Chromium. Padrão: /usr/bin/chromium-browser (imagem Docker).
# No Windows, por exemplo: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_BIN=/usr/bin/chromium-browser

# --- Assistente de voz (opcional) ---
# A chave da OpenAI é cadastrada pela tela de administração e fica cifrada no banco.
# Aqui só se troca o endpoint, para provedores compatíveis. Vazio = https://api.openai.com/v1
OPENAI_BASE_URL=

# --- Seeds de desenvolvimento (nunca em produção) ---
# "true" faz prisma/seed-dev-users.js e prisma/seed-dev-estoque.js criarem dados de teste.
SEED_DEV_USERS=false

NODE_ENV=development
